#!name=Locket_Gold60s
#!desc=Locket Gold + Quay video 60s + Đăng được video
#!author=subinnn05
#!homepage=https://github.com/subinnn05/Locket_Gold60s
#!moduleUrl=https://raw.githubusercontent.com/subinnn05/Locket_Gold60s/refs/heads/main/Locket_Gold60s.module
#!icon=https://raw.githubusercontent.com/ntanphatt/LocketGold/main/logo.jpg
#!howtouse=Shadowrocket

[Header Rewrite]
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag

[Script]
# 1. Giả lập mua Gold (RevenueCat)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/subinnn05/Locket_Gold60s/main/js/Locket_subinnn05.js, requires-body=true, max-size=-1, timeout=60

# 2. Xoá header cache
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/subinnn05/Locket_Gold60s/main/js/deleteHeader.js, timeout=60

# 3. Cấu hình 60s video & Upload (Firebase Remote Config)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/subinnn05/Locket_Gold60s/main/js/Locket_Config.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
